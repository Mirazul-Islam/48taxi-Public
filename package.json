{
  "name": "48taxi-public",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "48Taxi & Limo public website: React, pre-rendered for SEO, deployed on Netlify.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && node scripts/prerender.mjs && node scripts/check-seo.mjs",
    "build:client": "vite build --outDir dist",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir .ssr",
    "preview": "node scripts/serve.mjs",
    "images": "node scripts/optimize-images.mjs",
    "check": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "5.2.8",
    "lenis": "1.3.27",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "sharp": "0.34.4",
    "tailwindcss": "3.4.19",
    "vite": "5.4.21"
  }
}
